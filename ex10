int main(void) {
    int vetor[] = {1, 2, 3};

    int *p1;
    int **p2;
    int ***p3;

    p1 = vetor;
    p2 = &p1;
    p3 = &p2;

    printf("*p1 = %d\n", *p1);
    printf("**p2 = %d\n", **p2);
    printf("***p3 = %d\n", ***p3);

    ***p3 = 10;

    (*p2)++;

    ***p3 = 20;

    printf("%d %d %d\n", vetor[0], vetor[1], vetor[2]);

    return 0;
}
