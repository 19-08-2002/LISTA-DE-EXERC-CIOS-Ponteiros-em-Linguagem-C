#include <stdio.h>

int main(void) {
    int valor = 20;
    int *p = &valor;

    printf("Valor: %d\n", valor);
    printf("Endereco da variavel: %p\n", (void *)&valor);
    printf("Conteudo do ponteiro: %p\n", (void *)p);
    printf("Valor apontado: %d\n", *p);

    *p = 35;

    printf("Novo valor: %d\n", valor);

    return 0;
}
